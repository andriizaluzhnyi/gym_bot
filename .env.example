# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=123456789

# Database
DATABASE_URL=sqlite+aiosqlite:///./gym_bot.db

# Google API Configuration
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Timezone
TIMEZONE=Europe/Kyiv

# Web App (Mini App) - HTTPS URL required for Telegram
WEBAPP_URL=https://your-domain.com
WEBAPP_PORT=8080

# Notification Settings (hours before training)
REMINDER_HOURS_BEFORE_STR=24,2

# OpenAI (photo -> macros recognition, GYM-23). Leave OPENAI_API_KEY empty
# to disable the feature entirely (POST /api/nutrition/meal/photo then
# returns 503 and the "📷 Фото" button hides itself). Photos sent to
# OpenAI are not stored anywhere by this app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
